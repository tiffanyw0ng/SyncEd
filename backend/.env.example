# ============================================================
# Market-Sync AI — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The app works WITHOUT any of these (uses local cache).
# Set the Oracle ones to persist data to Oracle Cloud.
# ============================================================


# ------------------------------------------------------------
# ORACLE AUTONOMOUS DATABASE (Required for Option C)
# ------------------------------------------------------------
# You need 4 things from Oracle Cloud Console:
#
# 1. ORACLE_DSN — The connection string for your ADB instance
#    Format: (description=(retry_count=20)(retry_delay=3)(address=(protocol=tcps)(port=1522)(host=adb.us-ashburn-1.oraclecloud.com))(connect_data=(service_name=abc123_marketsync_high.adb.oraclecloud.com))(security=(ssl_server_dn_match=yes)))
#    Where to find it: OCI Console → Autonomous Database → Your DB → DB Connection → Connection Strings → Copy any one (recommend "high" or "tp")
#
# 2. ORACLE_USER — Database username (default is ADMIN)
#
# 3. ORACLE_PASSWORD — The password you set when creating the ADB
#
# 4. ORACLE_WALLET_DIR — Path to the downloaded wallet folder
#    Where to get it: OCI Console → Autonomous Database → Your DB → DB Connection → Download Wallet
#    Unzip it somewhere and put the path here (e.g. /Users/yourname/wallet)

ORACLE_DSN=
ORACLE_USER=ADMIN
ORACLE_PASSWORD=
ORACLE_WALLET_DIR=


# ------------------------------------------------------------
# OCI GENERAL CONFIG (Optional — for OCI SDK features)
# ------------------------------------------------------------
# Only needed if you want to use OCI GenAI or OCI Functions.
# You can skip these for the basic Oracle DB integration.
#
# OCI_CONFIG_FILE — Path to your OCI CLI config file
#   Where to get it: Run `oci setup config` or download from
#   OCI Console → Profile → API Keys → Download Config
#
# OCI_COMPARTMENT_ID — Your compartment OCID
#   Where to find it: OCI Console → Identity → Compartments → Copy OCID

OCI_CONFIG_FILE=~/.oci/config
OCI_COMPARTMENT_ID=


# ------------------------------------------------------------
# OCI GENERATIVE AI (Optional — for smarter gap analysis)
# ------------------------------------------------------------
# Uses Cohere or Llama models hosted on Oracle Cloud.
# Not needed for the TF-IDF based analysis (works locally).
#
# Where to find: OCI Console → AI Services → Generative AI

OCI_GENAI_ENDPOINT=https://inference.generativeai.us-chicago-1.oci.oraclecloud.com
OCI_GENAI_MODEL_ID=cohere.command-r-plus


# ------------------------------------------------------------
# APP CONFIG
# ------------------------------------------------------------

SCRAPE_INTERVAL_HOURS=24
SIMILARITY_THRESHOLD=0.65
